# copy to .env if you want to override defaults

PORT=8050
HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=false

# gunicorn (docker)
WEB_CONCURRENCY=1
GUNICORN_THREADS=8

# auto | synthetic | websocket | redis
FEED_SOURCE=auto
SYMBOL=BTC-USDT
EXCHANGE=SIMULATED
FEED_STALE_AFTER_SECONDS=6

SYNTHETIC_INTERVAL_SECONDS=1.0
SYNTHETIC_START_PRICE=65000
SYNTHETIC_VOLATILITY=0.0009
SYNTHETIC_SPREAD_BPS=1.0
SYNTHETIC_DEPTH=15

WEBSOCKET_URI=wss://ws.gomarket-cpp.goquant.io/ws/l2-orderbook/okx/BTC-USDT-SWAP

# optional - only set these if you actually have redis
# REDIS_URL=redis://:password@host:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_MAX_RETRIES=2

STOCK_SYMBOL=AAPL
STOCK_PROVIDER=finnhub
STOCK_POLL_INTERVAL=15
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# MODELS_DIR=/app/models
