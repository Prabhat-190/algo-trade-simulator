# Copy to .env and adjust. Every value below is optional: with no configuration
# at all the dashboard runs on port 8050 with an embedded synthetic market feed.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8050
HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=false

# Gunicorn (container only)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4

# ---------------------------------------------------------------------------
# Market data source
# ---------------------------------------------------------------------------
# auto      consume Redis if a feeder is publishing, else fall back to synthetic
# synthetic always generate data in-process (best for demos and offline work)
# websocket connect directly to WEBSOCKET_URI from the dashboard process
# redis     Redis only, no fallback (for multi-service deployments)
FEED_SOURCE=auto

SYMBOL=BTC-USDT
EXCHANGE=SIMULATED

# Seconds without a frame before the embedded fallback takes over (FEED_SOURCE=auto)
FEED_STALE_AFTER_SECONDS=6

# Synthetic feed tuning
SYNTHETIC_INTERVAL_SECONDS=1.0
SYNTHETIC_START_PRICE=65000
SYNTHETIC_VOLATILITY=0.0009
SYNTHETIC_SPREAD_BPS=1.0
SYNTHETIC_DEPTH=15

# Live crypto WebSocket (used by FEED_SOURCE=websocket and trading.data_feeder)
WEBSOCKET_URI=wss://ws.gomarket-cpp.goquant.io/ws/l2-orderbook/okx/BTC-USDT-SWAP

# ---------------------------------------------------------------------------
# Redis (optional — enables project storage shared across replicas)
# ---------------------------------------------------------------------------
# Either a single URL (what managed add-ons provide)...
# REDIS_URL=redis://:password@host:6379/0
# ...or a host/port pair:
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Stock feeder (optional, only for trading.stock_data_feeder)
# ---------------------------------------------------------------------------
STOCK_SYMBOL=AAPL
STOCK_PROVIDER=finnhub
STOCK_POLL_INTERVAL=15
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Optional pre-trained model weights (maker_taker_model.joblib, slippage_model.joblib)
# ---------------------------------------------------------------------------
# MODELS_DIR=/app/models
